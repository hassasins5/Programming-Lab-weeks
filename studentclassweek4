package hasansahin;

public class Student {
    public String name;
    public String studentID;
    int counter;

    public Student(String name, String studentID) {
        this.name = name;
        this.studentID = studentID;
    }

    @Override
    public String toString() {
        return "Student{" + "name=" + name + ", studentID=" + studentID + '}';
    }
}

