package hasansahin;

import java.util.ArrayList;

public class Course {
    public String courseName;
    public int capacity;
    public int counter;

    public Course(String courseName, int capacity) {
        this.courseName = courseName;
        this.capacity = capacity;
    }

    ArrayList<Student> enrolledStudent = new ArrayList<>();

    public void EnrolledStudent(Student student) {
        if (counter<capacity) {
            counter++;
            this.enrolledStudent.set(counter, student);
        }
    }

    @Override
    public String toString() {
        return "Course{" + "courseName=" + courseName + ", capacity=" + capacity + ", enrolledStudent=" + enrolledStudent + '}';
    }
}
