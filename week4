package hasansahin;

import java.util.ArrayList;
import java.util.Scanner;

public class HasanSahin {
    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);
        System.out.println("please enter how many course will you create (at least 3)");
        int courseNum = scanner.nextInt();
        if (courseNum<3) {
            System.out.println("please enter more than 3");
        }

        ArrayList<Course> courses = new ArrayList<>();
        for(int i = 1; i<=courseNum; i++){
            System.out.println("please enter the name of course: " + i);
            String courseName = scanner.next();
            scanner.nextLine();
            System.out.println("please enter the capacity of course" + i);
            int capacity = scanner.nextInt();
            Course coursesCourse = new Course(courseName, capacity);

            courses.add(coursesCourse);
        }
        for(int i = 0; i<courseNum; i++){
            System.out.println(courses.toString());
        }

        System.out.println("please enter student ID: ");
        String ID = scanner.next();
        scanner.nextLine();
        System.out.println("please enter student name: ");
        String name = scanner.nextLine();
        Student student = new Student(name, ID);

        System.out.println("wanted course: ");
        String neededCourse = scanner.nextLine();

        for(int i = 0; i<courseNum; i++){
            if (neededCourse.equals(courses.get(i))){
                if (courses.get(i).capacity>student.counter){
                    System.out.println("capacity is avaliable");
                }System.out.println("capacity is full");
            }else{
                System.out.println("no course found with that name");
            }
        }
    }
}
